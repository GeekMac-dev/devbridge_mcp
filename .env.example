# DevBridge MCP — copy to .env.local; never commit that file.
# The PowerShell launcher scripts/start-local.ps1 loads .env.local.
# Running npm start or npm run start:http directly does NOT load .env.local.

# Server: keep loopback only. Remote ChatGPT requires a supported secure tunnel
# or your own secured HTTPS endpoint. Do not port-forward 8788.
HOST=127.0.0.1
SQL_BRIDGE_PORT=8788

# Local MCP authentication: start-local.ps1 creates a strong random token
# in %LOCALAPPDATA%\DevBridgeMCP\mcp-token.txt if missing.
# Set a different absolute token path only when needed.
# MACBRIDGE_MCP_TOKEN_FILE=C:\Users\YourName\AppData\Local\DevBridgeMCP\mcp-token.txt

# Scope edits and project commands to trusted development roots.
# Separate multiple absolute paths using semicolons.
# CHANGE this example to match your machine.
BRIDGE_WRITE_ROOTS=D:\Projects

# Codex history integration (optional).
# CODEX_HOME=C:\Users\YourName\.codex

# Browser: disabled unless specifically enabled.
BRIDGE_BROWSER_ENABLED=0
BRIDGE_BROWSER_MODE=chromium
BRIDGE_BROWSER_HEADLESS=1
# Set an actual permitted development origin when enabling browser tools.
BRIDGE_BROWSER_ALLOWED_ORIGINS=
BRIDGE_BROWSER_REALTIME_ORIGIN=

# Project commands / terminal: individually opt in after reviewing permissions.
BRIDGE_PROJECT_COMMANDS_ENABLED=0
BRIDGE_TERMINAL_ENABLED=0
BRIDGE_TERMINAL_SCRIPTS_ENABLED=0

# Optional coding integrations.
BRIDGE_SEMGREP_ENABLED=0
BRIDGE_CONTEXT7_ENABLED=0

# Activity logging/viewer (optional).
BRIDGE_ACTIVITY_ENABLED=0
BRIDGE_ACTIVITY_PORT=8790

# Optional: OpenAI Secure MCP Tunnel (not needed for local build/tests).
# 1. Create a tunnel and copy its ID:
#    https://platform.openai.com/settings/organization/tunnels
#    Permissions to create: Tunnels Read + Manage
# 2. Create a RESTRICTED runtime API key with Tunnels Read + Use:
#    https://platform.openai.com/settings/organization/api-keys
# 3. Download the official Windows tunnel-client:
#    https://github.com/openai/tunnel-client/releases/latest
# 4. Set these values ONLY in .env.local, never commit them:
# TUNNEL_ROOT=C:\Tools\tunnel-client
# CONTROL_PLANE_TUNNEL_ID=tunnel_REPLACE_WITH_YOUR_ID
# CONTROL_PLANE_API_KEY=REPLACE_WITH_RESTRICTED_RUNTIME_KEY
# TUNNEL_ID=  # Optional legacy alias; prefer CONTROL_PLANE_TUNNEL_ID
#
# The bridge's local MCP bearer token (MACBRIDGE_MCP_TOKEN_FILE) is different
# from the Platform runtime API key. No admin key is required for routine use.
# See PLUGINS_SETUP.md for the complete tunnel and ChatGPT Plugins walkthrough.
